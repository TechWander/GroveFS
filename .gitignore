# Ad-hoc browser screenshots taken while verifying docs.html rendering; they
# document nothing the page itself doesn't, so they never belong in a commit.
/preview_top.png
/shot_*.png
/verify_*.png
/docs_theme_*.png
/docs_s*.png

# .build-bin tracks the test/bench scripts and the pkg-config wrapper,
# but never its run output or captured logs.
/.build-bin/logs/
/.build-bin/*.out

# Stray ad-hoc run logs
/edge_run.txt
/.build-bin/*.log
*.run.log

# LaTeX build artifacts under paper/ (only the .tex source is tracked; the
# rest are regenerable by latexmk/pdflatex).
/paper/*.aux
/paper/*.log
/paper/*.out
/paper/*.toc
/paper/*.fls
/paper/*.fdb_latexmk
/paper/*.bbl
/paper/*.blg
/paper/*.synctex.gz
/paper/comment.cut
/paper/*.pdf

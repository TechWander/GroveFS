# Rust build artifacts
/target/

# Preserved standalone release binary (copied out of target/ so it survives `cargo clean`)
/bin/

# Delivery packages (master worktree copies; ~200 MB of stripped binaries plus the
# FDB artifacts). Released artifacts live on orphan `dist/vN` branches, never in the
# main history, so a plain clone stays small — same rule as /bin/. Do NOT `git add -A`
# this directory onto master.
/dist/

# Evidence bench `.bneck/`: the *recipes* (`.sh`/`.py`/`.c`) are tracked because docs
# and the ledger cite them as reproduction steps; their captured output is machine-local
# and regenerable by re-running the recipe, so it never belongs in a commit.
/.bneck/central/
/.bneck/raw/
/.bneck/g3_evidence/
/.bneck/.pgtd/
/.bneck/__pycache__/
/.bneck/*.jsonl
/.bneck/*.log
/.bneck/*.so

# Local single-node FoundationDB cluster (cluster file, data dirs, server logs) used by
# the `fdb` suite and the package verifiers. Recreated by `.build-bin/fdb_env.sh up`.
/.fdbtest/
/.fdbtest-build.log

# Runtime / test scratch mounts and data dirs created by the suites
/.bench/
/.g3bench/
/.blk/
/.br/
/.ctest/
/.cttest/
/.demo_real/
/.demo_srv/
/.etest/
/.ftest/
/.fresh/
/.migtest/
/.ha/
/.ha_sync_test/
/.locks/
/.msrv/
/.ptest/
/.rtest/
/.striping/
/.test/
/.xtest/
/.pgtest/
/.pgtest2/
/.ltest/
/.itest/
/.dfresh/
/.govcheck/
/.govtime/
/.grovesci/
/.pgpar/
/.apitest/
/.demomcp/
/.mcptest/
/.mktest/
/.cfgtest/
/.vrtest/
/.gctest/
/.bwtest/
/.ruletest/
/.skilltest/
/.dperf*/
/.sigtest/
/.bt-t*/
/.evicttest/
/.s7test/
/.rgap/
/.f63/
/.ctltest/
/.forkpgtest/
/.forktest2/
/.gcremtest/
/.pgbench/
/.xfertest/
/.probe_sync/
/.fdb3bench/
/.fdb3bench_*.out

# Regenerable docs.html backups left behind by in-place rewrites.
/docs-original.html
/docs.html.bak.*

# Ad-hoc browser screenshots taken while verifying docs.html rendering; they
# document nothing the page itself doesn't, so they never belong in a commit.
/preview_top.png
/shot_*.png
/verify_*.png
/docs_theme_*.png
/docs_s*.png

# .build-bin tracks the test/bench scripts and the pkg-config wrapper,
# but never its run output or captured logs.
/.build-bin/logs/
/.build-bin/*.out

# Stray ad-hoc run logs
/edge_run.txt
/.build-bin/*.log
*.run.log

# LaTeX build artifacts under paper/ (only the .tex source is tracked; the
# rest are regenerable by latexmk/pdflatex).
/paper/*.aux
/paper/*.log
/paper/*.out
/paper/*.toc
/paper/*.fls
/paper/*.fdb_latexmk
/paper/*.bbl
/paper/*.blg
/paper/*.synctex.gz
/paper/comment.cut
/paper/*.pdf

# VM  provisioning 脚本含 cloud-init 明文口令，绝不入库（改读环境变量后再纳入）。
/.build-bin/gfs_provision.sh
